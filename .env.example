# Copy this file to .env and adjust values as needed.
# None of these are required to run the pipeline with defaults from
# config/config.yaml -- they are optional overrides.

# Path to the YAML configuration file used by main.py.
BCT_AI_CONFIG_PATH=config/config.yaml

# Override the global random seed (defaults to the value in config.yaml).
BCT_AI_RANDOM_SEED=42

# Directory where results/simulation_results.csv and
# results/performance_metrics.json are written.
BCT_AI_RESULTS_DIR=results

# Python logging level: DEBUG, INFO, WARNING, ERROR.
BCT_AI_LOG_LEVEL=INFO

# Restrict TensorFlow/PyTorch to specific GPUs (empty string = CPU only).
CUDA_VISIBLE_DEVICES=

# Silence verbose TensorFlow C++ backend logging (0=all, 1=info, 2=warning, 3=error).
TF_CPP_MIN_LOG_LEVEL=2
